# Copy to .env and fill in. Never commit the real .env file.

# MongoDB connection string and database name
MONGO_URL=mongodb://localhost:27017
DB_NAME=cashflo

# Long random string used to sign login tokens, e.g. from: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Stripe (optional for now). The webhook endpoint refuses all events until both are set.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
