# Copy to .env and fill in. Never commit the real .env file.

# MongoDB connection string and database name
MONGO_URL=mongodb://localhost:27017
DB_NAME=cashflo

# Long random string used to sign login tokens, e.g. from: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Public address of this server (no trailing slash), e.g. https://api.cashflo.cash
PUBLIC_API_URL=

# --- Stripe ---------------------------------------------------------------
# Secret key (Developers -> API keys). Use a restricted or test key while testing.
STRIPE_API_KEY=
# Signing secret of the webhook endpoint <PUBLIC_API_URL>/api/webhook/stripe.
# Events to send: checkout.session.completed, checkout.session.async_payment_succeeded,
# customer.subscription.updated, customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=
# Price IDs of the three Pro plans (live mode values in the CashFlo Stripe account)
STRIPE_PRICE_MONTHLY=price_1TD3HdJdJIQXpk7ZHO00MjRx
STRIPE_PRICE_YEARLY=price_1TD3HgJdJIQXpk7ZeNdgCIdT
STRIPE_PRICE_LIFETIME=price_1TD3HcJdJIQXpk7Z1HKpgZ03
# Web addresses of the app that checkout may return to (comma separated), e.g. https://app.cashflo.cash
ALLOWED_RETURN_ORIGINS=
# Deep-link scheme of the mobile app (app.json -> expo.scheme)
APP_SCHEME=cashflo

# --- E-mail for password reset codes ---------------------------------------
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=cashflo2026@gmail.com,
# SMTP_PASSWORD=<an app password from Google Account -> Security -> App passwords>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=CashFlo <cashflo2026@gmail.com>
